# Whitelist: ship only what is needed to build (plus the README and its images).
# Everything not listed here -- build output, screenshots, debug/capture tooling, the original
# (unfixed) fonts, source mp3s, personal notes -- is ignored.
/*
!/.gitignore
!/LICENSE
!/README.md
!/CMakeLists.txt
!/src/
!/sce_sys/
!/assets/
!/third_party/
!/updater/
!/plugin/
!/docs/
!/tools/

# local notes for the next session (the whitelist above already ignores them; named here so it is explicit)
/HANDOFF.md
/THEMES_HANDOFF.md
/CHANGELOG_since_1.3.4.md
/LOCAL_CHANGES.md

# only the PSP icons the code actually loads
/assets/icons/tex_camera.png
/assets/icons/tex_cert.png
/assets/icons/tex_cnf_password.png
/assets/icons/tex_cnf_rss.png
/assets/icons/tex_update.png

# third_party: just the headers and the import stub that the build uses
/third_party/vitashell_stub/*
!/third_party/vitashell_stub/vitashell_user.h
!/third_party/vitashell_stub/vitashell_kernel.h
!/third_party/vitashell_stub/libVitaShellUser_stub_weak.a

# docs: README images and the demo GIF only
/docs/*
!/docs/images/
!/docs/demo.gif

# tools: only what is needed to build (FFmpeg for the video player) and the scripts that made the committed pictures
/tools/*
!/tools/build_ffmpeg.sh
!/tools/ffmpeg_vita_patch.py
!/tools/make_native_music.py
!/tools/make_native_video.py
!/tools/make_app_art.py
!/tools/make_flat_rco.py
!/tools/rlz.py
/tools/SourceSans3.ttf

# the FFmpeg libraries are built locally with tools/build_ffmpeg.sh (about 10 MB)
/third_party/ffmpeg-vita/

# the PSP-side game launcher (built with pspdev, output is assets/psp/vxmbboot.pbp) and the language file generator
!/psp/
/psp/*
!/psp/launcher/
/psp/launcher/*
!/psp/launcher/main.c
!/psp/launcher/Makefile
!/psp/launcher/build.sh
!/tools/lang/
/tools/lang/__pycache__/
!/psp/launcher/env.sh
